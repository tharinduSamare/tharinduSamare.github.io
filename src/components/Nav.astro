---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';
import ThemeToggle from './ThemeToggle.astro';

const isHomePage =
	Astro.url.pathname === '/' ||
	Astro.url.pathname === import.meta.env.BASE_URL;

/** Navigation used on the home page */
const homeLinks: {
	label: string;
	href: string;
	section: string;
}[] = [
	{ label: 'Home', href: '/', section: '' },
	{ label: 'Career', href: '/#career', section: 'career' },
	{ label: 'Projects', href: '/#projects', section: 'projects' },
	{ label: 'About', href: '/#about', section: 'about' },
];

/** Navigation used on other pages */
const pageLinks: {
	label: string;
	href: string;
	section?: string;
}[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Projects', href: '/work/' },
	{ label: 'About', href: '/about/' },
];

const navLinks = isHomePage ? homeLinks : pageLinks;

/** Social media links */
const iconLinks: {
	label: string;
	href: string;
	icon: keyof typeof iconPaths;
}[] = [
	{
		label: 'linkedin',
		href: 'https://www.linkedin.com/in/tharindusamare/',
		icon: 'linkedin-logo',
	},
	{
		label: 'GitHub',
		href: 'https://github.com/tharinduSamare',
		icon: 'github-logo',
	},
	{
		label: 'YouTube',
		href: 'https://www.youtube.com/@tharindusamarakoon2030/',
		icon: 'youtube-logo',
	},
	{
		label: 'instagram',
		href: 'https://www.instagram.com/tharindu.samarakoon.97/',
		icon: 'instagram-logo',
	},
	{
		label: 'Facebook',
		href: 'https://www.facebook.com/tharindu.samarakoon.52',
		icon: 'facebook-logo',
	}
];

const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');

	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';

	return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<!-- Social links and theme toggle -->
<div class="top-actions">
	<div class="socials">
		{
			iconLinks.map(({ href, icon, label }) => (
				<a
					href={href}
					class="social"
					target="_blank"
					rel="noopener noreferrer"
				>
					<span class="sr-only">{label}</span>
					<Icon icon={icon} />
				</a>
			))
		}
	</div>

	<div class="theme-toggle">
		<ThemeToggle />
	</div>
</div>

<!-- Main navigation -->
<nav class:list={{ 'home-nav': isHomePage }}>
	<div class="menu-header">
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>

	<noscript>
		<ul class="nav-items">
			{
				navLinks.map(({ label, href }) => (
					<li>
						<a
							class="link"
							href={href}
							aria-current={
								!isHomePage && isCurrentPage(href)
									? 'page'
									: null
							}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>

	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				navLinks.map(({ label, href, section }) => (
					<li>
						<a
							class="link"
							href={href}
							data-section={section ?? ''}
							aria-current={
								!isHomePage && isCurrentPage(href)
									? 'page'
									: null
							}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			this.appendChild(
				this.querySelector('template')!.content.cloneNode(true)
			);

			const btn = this.querySelector('button')!;
			const menu = document.getElementById('menu-content')!;

			menu.hidden = true;
			menu.classList.add('menu-content');

			const setExpanded = (expand: boolean) => {
				btn.setAttribute(
					'aria-expanded',
					expand ? 'true' : 'false'
				);

				menu.hidden = !expand;
			};

			btn.addEventListener('click', () => {
				setExpanded(menu.hidden === true);
			});

			const handleViewports = (
				e: MediaQueryList | MediaQueryListEvent
			) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};

			const mediaQueries = window.matchMedia('(min-width: 50em)');

			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}

	customElements.define('menu-button', MenuButton);

	/*
	 * Home page section highlighting
	 */
	const homeNav = document.querySelector('nav.home-nav');

	if (homeNav) {
		const links =
			homeNav.querySelectorAll<HTMLAnchorElement>(
				'.link[data-section]'
			);

		const sections = ['career', 'projects', 'about']
			.map((id) => document.getElementById(id))
			.filter(
				(section): section is HTMLElement =>
					section !== null
			);

		const setActive = (section: string) => {
			links.forEach((link) => {
				const linkSection = link.dataset.section ?? '';

				if (linkSection === section) {
					link.setAttribute('aria-current', 'page');
				} else {
					link.removeAttribute('aria-current');
				}
			});
		};

		/*
		 * Start with Home highlighted.
		 */
		setActive('');

		/*
		 * Update active section while scrolling.
		 */
		const updateActiveSection = () => {
			if (window.scrollY < 150) {
				setActive('');
				return;
			}

			const scrollPosition = window.scrollY + 180;

			let activeSection = '';

			for (const section of sections) {
				if (section.offsetTop <= scrollPosition) {
					activeSection = section.id;
				}
			}

			setActive(activeSection);
		};

		window.addEventListener(
			'scroll',
			updateActiveSection,
			{ passive: true }
		);

		window.addEventListener(
			'resize',
			updateActiveSection
		);

		updateActiveSection();

		/*
		 * IMPORTANT:
		 *
		 * If we are already on the home page,
		 * Home should scroll to the top instead
		 * of navigating/reloading the page.
		 */
		const homeLink =
			homeNav.querySelector<HTMLAnchorElement>(
				'.link[data-section=""]'
			);

		homeLink?.addEventListener('click', (event) => {
			event.preventDefault();

			setActive('');

			window.scrollTo({
				top: 0,
				behavior: 'smooth',
			});
		});

		/*
		 * Close mobile menu after clicking a link.
		 */
		links.forEach((link) => {
			link.addEventListener('click', () => {
				const menu =
					document.getElementById('menu-content');

				if (menu) {
					menu.hidden = true;
				}
			});
		});
	}

	const topActions =
		document.querySelector<HTMLElement>('.top-actions');

	if (topActions) {
		const updateTopActions = () => {
			topActions.classList.toggle(
				'scrolled',
				window.scrollY > 80
			);
		};

		window.addEventListener(
			'scroll',
			updateTopActions,
			{ passive: true }
		);

		updateTopActions();
	}
</script>

<style>
	/*
	 * -----------------------------------------
	 * TOP RIGHT ACTIONS
	 * -----------------------------------------
	 */

	.top-actions {
		position: fixed;
		top: 1.25rem;
		right: 1.5rem;
		z-index: 10000;

		display: flex;
		align-items: center;
		gap: 0.5rem;

		padding: 0.4rem 0.6rem;

		background: rgba(255, 255, 255, 0.72);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);

		border: 1px solid var(--gray-800);
		border-radius: 999rem;
		box-shadow: var(--shadow-sm);

		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	.socials {
		display: flex;
		align-items: center;
		gap: 0.1rem;
	}

	.social {
		display: flex;
		align-items: center;
		justify-content: center;

		padding: 0.3rem;

		color: var(--accent-regular);
		text-decoration: none;

		border-radius: 999rem;

		transition:
			color var(--theme-transition),
			background-color var(--theme-transition),
			transform var(--theme-transition);
	}

	.social :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
	}

	.social:hover,
	.social:focus {
		color: var(--accent-dark);
		background-color: var(--accent-subtle-overlay);
		transform: translateY(-1px);
	}

	.theme-toggle {
		display: flex;
		align-items: center;

		padding-left: 0.25rem;
		margin-left: 0.25rem;

		border-left: 1px solid var(--gray-700);
	}

	/*
	 * -----------------------------------------
	 * MAIN NAVIGATION
	 * -----------------------------------------
	 */

	nav {
		z-index: 9999;
		position: fixed;
		top: 1rem;
		left: 50%;

		width: max-content;
		max-width: calc(100% - 2rem);

		transform: translateX(-50%);

		font-family: var(--font-brand);
		font-weight: 500;
	}

	.menu-header {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.menu-button {
		position: relative;
		display: flex;

		border: 0;
		border-radius: 999rem;
		padding: 0.5rem;

		font-size: 1.5rem;
		color: var(--gray-300);

		background: radial-gradient(
			var(--gray-900),
			var(--gray-800) 150%
		);

		box-shadow: var(--shadow-md);
	}

	.menu-button[aria-expanded='true'] {
		color: var(--gray-0);

		background:
			linear-gradient(
				180deg,
				var(--gray-600),
				transparent
			),
			radial-gradient(
				var(--gray-900),
				var(--gray-800) 150%
			);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-button::before {
		position: absolute;
		inset: -1px;

		content: '';

		background: var(--gradient-stroke);
		border-radius: 999rem;

		z-index: -1;
	}

	.menu-content {
		position: absolute;

		left: 50%;
		top: calc(100% + 0.5rem);

		transform: translateX(-50%);

		width: max-content;
	}

	.nav-items {
		margin: 0;

		display: flex;
		flex-direction: column;
		gap: 1rem;

		font-size: var(--text-md);
		line-height: 1.2;

		list-style: none;
		padding: 1.5rem;

		background: rgba(255, 255, 255, 0.94);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);

		border: 1px solid var(--gray-800);
		border-radius: 1rem;

		box-shadow: var(--shadow-lg);
	}

	.link {
		display: inline-block;

		color: var(--gray-300);
		text-decoration: none;
	}

	.link[aria-current='page'] {
		color: var(--gray-0);
	}

	.top-actions.scrolled {
		opacity: 0;
		transform: translateY(-1rem);
		pointer-events: none;
	}

	@media (min-width: 50em) {
		/*
		 * Desktop navigation becomes a simple
		 * centered pill.
		 */
		nav {
			top: 1.25rem;

			padding: 0.35rem;

			background: rgba(255, 255, 255, 0.72);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);

			border: 1px solid var(--gray-800);
			border-radius: 1rem;

			box-shadow: var(--shadow-md);
		}

		.menu-header {
			display: none;
		}

		.menu-content {
			position: static;
			display: block;
			transform: none;
			width: auto;
		}

		.nav-items {
			position: relative;

			flex-direction: row;
			justify-content: center;
			gap: 0.25rem;

			font-size: var(--text-sm);

			border: 0;
			padding: 0;

			background: transparent;
			box-shadow: none;
		}

		.link {
			padding: 0.5rem 0.9rem;
			border-radius: 0.65rem;

			transition:
				color var(--theme-transition),
				background-color var(--theme-transition),
				transform var(--theme-transition);
		}

		.link:hover,
		.link:focus {
			color: var(--gray-100);
			background-color: var(--accent-subtle-overlay);
		}

		.link[aria-current='page'] {
			color: var(--accent-text-over);
			background-color: var(--accent-regular);
		}
	}

	@media (max-width: 49.99em) {
		/*
		 * On mobile, put the actions back into
		 * the menu so they don't consume screen space.
		 */
		.top-actions {
			display: none;
		}

		nav {
			top: 1rem;
			width: calc(100% - 2rem);
		}
	}

	@media (min-width: 60em) {
		.top-actions {
			right: 2rem;
		}
	}

	@media (forced-colors: active) {
		.link[aria-current='page'] {
			color: SelectedItem;
		}
	}
</style>