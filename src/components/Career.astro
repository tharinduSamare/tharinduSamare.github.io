---
import CareerCard from './CareerCard.astro';
import career from '../content/career/career.json';

const LIMIT = 6;
---

<section class="career-section wrapper" id="career">
	<div class="career-header">
		<div>
			<p class="section-label">/ Career</p>

			<h2>Where I've been</h2>
		</div>

		<p class="career-intro">
			A quick look at my education and professional experience.
		</p>
	</div>

	<div class="career-filters" role="tablist" aria-label="Filter career timeline">
		<button
			class="career-filter active"
			data-filter="all"
			type="button"
			role="tab"
			aria-selected="true"
		>
			All
		</button>

		<button
			class="career-filter"
			data-filter="Work"
			type="button"
			role="tab"
			aria-selected="false"
		>
			Work
		</button>

		<button
			class="career-filter"
			data-filter="Education"
			type="button"
			role="tab"
			aria-selected="false"
		>
			Education
		</button>
	</div>

	<div class="career-timeline">
		<div class="timeline-line"></div>

		{
			career.slice(0, LIMIT).map((item, index) => (
				<div
					class="career-item reveal"
					data-type={item.type}
					data-index={index}
				>
					<div class="timeline-dot">
						<div class="timeline-dot-inner"></div>
					</div>

					<CareerCard
						company={item.company}
						role={item.role}
						period={item.period}
						type={item.type}
						description={item.description}
                        highlights={item.highlights}
						skills={item.skills}
						url={item.url}
						side={index % 2 === 0 ? 'left' : 'right'}
					/>
				</div>
			))
		}
	</div>
</section>

<script>
	const setupCareer = () => {
		const filters = document.querySelectorAll<HTMLButtonElement>(
			'.career-filter'
		);

		const items = document.querySelectorAll<HTMLElement>('.career-item');

		filters.forEach((filter) => {
			filter.addEventListener('click', () => {
				const selected = filter.dataset.filter || 'all';

				filters.forEach((button) => {
					const active = button === filter;

					button.classList.toggle('active', active);
					button.setAttribute(
						'aria-selected',
						active ? 'true' : 'false'
					);
				});

				items.forEach((item) => {
					const type = item.dataset.type;

					const visible =
						selected === 'all' || type === selected;

					item.classList.toggle('hidden', !visible);
				});
			});
		});

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{
				threshold: 0.12,
			}
		);

		items.forEach((item) => observer.observe(item));
	};

	setupCareer();

	document.addEventListener('astro:after-swap', setupCareer);
</script>

<style>
	.career-section {
		padding-top: 7rem;
		padding-bottom: 7rem;
	}

	.career-header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.section-label {
		margin-bottom: 0.7rem;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-dark);
	}

	.career-header h2 {
		margin: 0;
	}

	.career-intro {
		max-width: 25rem;
		margin: 0;
		color: var(--gray-400);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.career-filters {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 3.5rem;
	}

	.career-filter {
		border: 1px solid color-mix(in srgb, var(--gray-700) 70%, transparent);
		border-radius: 999px;
		padding: 0.5rem 1rem;
		background: color-mix(in srgb, var(--gray-999) 70%, transparent);
		color: var(--gray-400);
		font: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		transition:
			background 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.career-filter:hover {
		color: var(--gray-100);
		border-color: var(--accent-regular);
	}

	.career-filter.active {
		background: var(--accent-regular);
		border-color: var(--accent-regular);
		color: var(--accent-text-over);
	}

	.career-timeline {
		position: relative;
		width: 100%;
		padding: 0.5rem 0;
	}

	.timeline-line {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 1px;
		transform: translateX(-50%);
		background: linear-gradient(
			to bottom,
			transparent,
			var(--gray-600) 8%,
			var(--gray-600) 92%,
			transparent
		);
	}

	.career-item {
		position: relative;
		display: flex;
		width: 100%;
		min-height: 12rem;
		margin-bottom: 2.5rem;
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}

	.career-item.hidden {
		display: none;
	}

	.career-item.reveal {
		opacity: 0;
		transform: translateY(20px);
	}

	.career-item.reveal.visible {
		opacity: 1;
		transform: translateY(0);
	}

	.timeline-dot {
		position: absolute;
		z-index: 2;
		top: 2rem;
		left: 50%;
		width: 14px;
		height: 14px;
		transform: translateX(-50%);
		border: 2px solid var(--gray-999);
		border-radius: 50%;
		background: var(--accent-regular);
		box-shadow: 0 0 0 4px var(--accent-subtle-overlay);
	}

	.timeline-dot-inner {
		width: 100%;
		height: 100%;
		border-radius: inherit;
		background: var(--accent-light);
		opacity: 0.8;
	}

	@media (max-width: 50em) {
		.career-section {
			padding-top: 5rem;
			padding-bottom: 5rem;
		}

		.career-header {
			display: block;
		}

		.career-intro {
			margin-top: 1rem;
		}

		.career-filters {
			margin-bottom: 2.5rem;
		}

		.timeline-line {
			left: 8px;
			transform: none;
		}

		.timeline-dot {
			left: 8px;
			top: 2rem;
		}

		.career-item {
			padding-left: 2rem;
			min-height: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.career-item.reveal {
			opacity: 1;
			transform: none;
		}

		.career-card {
			transition: none;
		}
	}
</style>