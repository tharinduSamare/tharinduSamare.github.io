---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;

const formatProjectDate = (date: string) => {
  const [year, month] = date.split('/');

  return new Date(Number(year), Number(month) - 1).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
  });
};
---

<div class="project-preview">
	<a class="title" href={`/work/${id}`}>
		{data.title}
	</a>

	<span class="project-date">
		{formatProjectDate(data.start_date)}
    	{data.end_date && ` - ${formatProjectDate(data.end_date)}`}
	</span>

	<a class="card" href={`/work/${id}`}>
		<img
			src={data.img}
			alt={data.img_alt || ''}
			loading="lazy"
			decoding="async"
		/>
	</a>
</div>

<style>
	.project-preview {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.title {
		display: inline-block;
		width: fit-content;
		margin: 0;
		padding: 0.5rem 1rem;

		/* background: var(--gray-900); */
		color: var(--gray-200);
		border-radius: 0.375rem;

		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		line-height: 1.2;
		text-decoration: none;

		transition:
			color var(--theme-transition),
			transform var(--theme-transition);
	}

	/* Highlight title when hovering anywhere over the project */
	.project-preview:hover .title {
		color: var(--accent-dark);
	}

	.card {
		display: block;
		height: 11rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition:
			box-shadow var(--theme-transition),
			transform var(--theme-transition);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.project-date {
		color: var(--gray-500);
		font-size: 0.85rem;
		white-space: nowrap;
		padding: 0rem 1rem;
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}
	}
</style>