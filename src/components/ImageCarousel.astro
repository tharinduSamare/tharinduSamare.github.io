---
interface ImageItem {
	src: string;
	alt: string;
}

interface Props {
	images: ImageItem[];
	interval?: number;
}

const { images, interval = 5000 } = Astro.props;
---

<div class="carousel" data-interval={interval}>
	<div class="slides">
		{images.map((image, index) => (
			<div class:list={['slide', { active: index === 0 }]}>
				<img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} />
			</div>
		))}

		<button
			class="arrow arrow-prev"
			type="button"
			aria-label="Previous photo"
		>
			<span aria-hidden="true">‹</span>
		</button>

		<button
			class="arrow arrow-next"
			type="button"
			aria-label="Next photo"
		>
			<span aria-hidden="true">›</span>
		</button>
	</div>

	<div class="dots" aria-label="Choose photo">
		{images.map((_, index) => (
			<button
				class:list={['dot', { active: index === 0 }]}
				type="button"
				aria-label={`Show photo ${index + 1}`}
				aria-current={index === 0 ? 'true' : undefined}
				data-index={index}
			></button>
		))}
	</div>
</div>

<script>
	const carousels = document.querySelectorAll<HTMLElement>('.carousel');

	carousels.forEach((carousel) => {
		const slides = carousel.querySelectorAll<HTMLElement>('.slide');
		const dots = carousel.querySelectorAll<HTMLButtonElement>('.dot');
		const prevButton = carousel.querySelector<HTMLButtonElement>('.arrow-prev');
		const nextButton = carousel.querySelector<HTMLButtonElement>('.arrow-next');
		const interval = Number(carousel.dataset.interval) || 5000;

		let current = 0;
		let timer: ReturnType<typeof setInterval>;

		function showSlide(index: number) {
			slides[current].classList.remove('active');
			dots[current].classList.remove('active');
			dots[current].removeAttribute('aria-current');

			current = (index + slides.length) % slides.length;

			slides[current].classList.add('active');
			dots[current].classList.add('active');
			dots[current].setAttribute('aria-current', 'true');
		}

		function nextSlide() {
			showSlide(current + 1);
		}

		function previousSlide() {
			showSlide(current - 1);
		}

		function startTimer() {
			clearInterval(timer);
			timer = setInterval(nextSlide, interval);
		}

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				showSlide(Number(dot.dataset.index));
				startTimer();
			});
		});

		prevButton?.addEventListener('click', () => {
			previousSlide();
			startTimer();
		});

		nextButton?.addEventListener('click', () => {
			nextSlide();
			startTimer();
		});

		startTimer();
	});
</script>

<style>
	.carousel {
		width: 100%;
		max-width: 100%;
		margin: 1.5rem 0 0;
	}

	.slides {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
		background: var(--gray-50);
	}

	.slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.7s ease;
		pointer-events: none;
	}

	.slide.active {
		opacity: 1;
		pointer-events: auto;
	}

	.slide img {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		object-fit: cover;
		border-radius: 0;
		box-shadow: none;
	}

	/* Navigation arrows */
	.arrow {
		position: absolute;
		top: 50%;
		z-index: 5;

		display: flex;
		align-items: center;
		justify-content: center;

		width: 2.75rem;
		height: 2.75rem;
		padding: 0;

		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 50%;

		background: rgba(0, 0, 0, 0.2);
		color: white;

		font-size: 2rem;
		font-family: Arial, sans-serif;
		font-weight: 300;
		line-height: 1;

		cursor: pointer;

		opacity: 0.18;
		transform: translateY(-50%);

		transition:
			opacity 0.25s ease,
			background 0.25s ease,
			transform 0.25s ease,
			border-color 0.25s ease;
	}

	.arrow-prev {
		left: 1rem;
	}

	.arrow-next {
		right: 1rem;
	}

	/* Make arrows clearly visible when hovering over the carousel */
	.carousel:hover .arrow {
		opacity: 0.75;
	}

	.arrow:hover {
		opacity: 1;
		background: rgba(0, 0, 0, 0.45);
		border-color: rgba(255, 255, 255, 0.5);
		transform: translateY(-50%) scale(1.08);
	}

	.arrow:focus-visible {
		opacity: 1;
		outline: 2px solid white;
		outline-offset: 3px;
	}

	.dots {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.dot {
		width: 0.55rem;
		height: 0.55rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--gray-500);
		opacity: 0.5;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease,
			background 0.2s ease;
	}

	.dot:hover {
		opacity: 1;
		transform: scale(1.15);
	}

	.dot.active {
		background: var(--accent-dark);
		opacity: 1;
		transform: scale(1.15);
	}

	@media (min-width: 50em) {
		.carousel {
			margin-top: 1.5rem;
		}

		.slides {
			border-radius: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.slide {
			transition: none;
		}

		.arrow {
			transition: none;
		}
	}
</style>