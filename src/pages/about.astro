							src: '/assets/images/life/bouldering.jpg',
							alt: 'Bouldering',
						},
						{
							src: '/assets/images/life/VideoCapture_20261002-bouldering.png',
							alt: 'Bouldering2',
						},
						{
							src: '/assets/images/life/20260919_cycling_koblenz.jpg',
							alt: 'Cycling',
						},
						{
							src: '/assets/images/life/VideoCapture_20261002-calistanics.jpg',
							alt: 'Calistanics-handstand',
						},
						{
							src: '/assets/images/life/VideoCapture_20261002-calistanics2.jpg',
							alt: 'Calistanics-backlever',
