		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			>
				<!-- <img
					width="1553"
					height="873"
					src="/assets/images/tharindu/tharindu_with_friends.jpeg"
					alt="Tharindu Samarakoon with friends"
				/> -->

				<ImageCarousel
					images={[
						{
							src: '/assets/images/life/IMG_E2677_music.jpg',
							alt: 'Playing music with Mit Karte Bitte',
						},
						{
							src: '/assets/images/life/20251130_hike_freiburg.jpg',
							alt: 'Hiking',
						},
						{
							src: '/assets/images/life/IMG-20250517-hiking2.jpg',
							alt: 'Hiking2',
						},
						{
							src: '/assets/images/life/tharindu_with_friends.jpeg',
							alt: 'Hanging out with friends',
						},
						{
							src: '/assets/images/life/VideoCapture_20260515-MTB.jpg',
							alt: 'Mountain biking',
						},
