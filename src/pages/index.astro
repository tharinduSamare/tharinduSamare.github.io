---
import { getCollection } from 'astro:content';
// Component Imports
import CallToAction from '../components/CallToAction.astro';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Skills from '../components/Skills.astro';
import Career from '../components/Career.astro';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageCarousel from '../components/ImageCarousel.astro';

// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-12 lg:gap-24">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Hello, I'm Tharindu Samarakoon"
					tagline="I am an Embedded Systems and Digital Hardware Engineer specializing in FPGA, ASIC & RISC-V."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="cpu" size="1.33em" /> FPGA</Pill>
						<Pill><Icon icon="cpu" size="1.33em" /> ASIC</Pill>
						<Pill><Icon icon="computer" size="1.33em" /> RISC-V</Pill>
						<Pill><Icon icon="code" size="1.33em" /> RTL</Pill>
						<Pill><Icon icon="shield-check" size="1.33em" /> UVM</Pill>
					</div>

					<div class="roles">
						<Pill><Icon icon="code" size="1.33em" /> SystemVerilog</Pill>
						<Pill><Icon icon="code" size="1.33em" /> Verilog</Pill>
						<Pill><Icon icon="terminal-window" size="1.33em" /> C++</Pill>
						<Pill><Icon icon="terminal-window" size="1.33em" /> Python</Pill>
					</div>

					<div class="roles">
						<Pill><Icon icon="computer" size="1.33em" /> Computer Architecture</Pill>
						<Pill><Icon icon="computer" size="1.33em" /> Digital Design</Pill>
					</div>
					
					<div class="cv-button">
						<a href="/assets/cv/Tharindu_Samarakoon_CV.pdf" target="_blank" rel="noopener noreferrer">
							<Icon icon="file-pdf" size="1.1em" />
							View CV
						</a>
					</div>
				</Hero>

				<img
					alt="Portrait of Tharindu Samarakoon"
					width="480"
					height="620"
					src="/assets/images/tharindu/tharindu_samarakoon2.jpg"
				/>
			</header>

			<!-- <Skills /> -->
		</div>
		
		<Career />

		<main class="wrapper stack gap-20 lg:gap-0">
			<section id="projects" class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<p class="section-label">/ Projects</p>
					<h3>What I've built</h3>
					<p>A selection of projects I've worked on throughout my studies and career.</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>

					<div class="projects-cta">
						<CallToAction href="/work/">
							View All
							<Icon icon="arrow-right" size="1.2em" />
						</CallToAction>
					</div>
				</div>
			</section>

			<!-- About preview -->
			<section id="about" class="about-preview">
				<div class="about-preview-content">
					<header class="section-header stack gap-2 lg:gap-4">
						<p class="section-label">/ About</p>
						<h3>A little more about me</h3>
					</header>

					<div class="about-preview-text">
						<p>
							I'm an Embedded Systems and Digital Hardware Engineer with a strong
							interest in digital design, computer architecture, RISC-V, FPGA and
							ASIC development.
						</p>

						<p>
							Outside of hardware, I enjoy mountain biking, hiking, bouldering, playing
							music and exploring new places.
						</p>
					</div>

					<div class="about-preview-carousel">
						<ImageCarousel
							images={[
							{
								src: '/assets/images/life/IMG_E2677_music.jpg',
								alt: 'Playing music with Mit Karte Bitte',
							},
							{
								src: '/assets/images/life/20251130_hike_freiburg.jpg',
								alt: 'Hiking',
							},
							{
								src: '/assets/images/life/tharindu_with_friends.jpeg',
								alt: 'Hanging out with friends',
							},
							{
								src: '/assets/images/life/VideoCapture_20260515-MTB.jpg',
								alt: 'Mountain biking',
							},
							{
								src: '/assets/images/life/bouldering.jpg',
								alt: 'Bouldering',
							},
							{
								src: '/assets/images/life/20260919_cycling_koblenz.jpg',
								alt: 'Cycling',
							},
							{
								src: '/assets/images/life/VideoCapture_20261002-calistanics.jpg',
								alt: 'Calisthenics - handstand',
							},
							{
								src: '/assets/images/life/VideoCapture_20261002-calistanics2.jpg',
								alt: 'Calisthenics - back lever',
							},
							{
								src: '/assets/images/life/VideoCapture_20261002-karting.jpg',
								alt: 'Go karting',
							},
							]}
						/>
					</div>

					<div class="about-cta">
						<CallToAction href="/about/">
							View More
							<Icon icon="arrow-right" size="1.2em" />
						</CallToAction>
					</div>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	.projects-cta {
		display: flex;
		justify-content: center;
		margin-top: 2rem;
		margin-bottom: 1rem;
	}

	.cv-button {
		display: flex;
		justify-content: center;
		margin-top: 1.5rem;
	}

	.cv-button a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;

		padding: 0.7rem 1.3rem;

		border: 1px solid var(--accent-regular);
		border-radius: 0.75rem;

		background: var(--gray-50);
		color: var(--accent-regular);

		font-family: var(--font-brand);
		font-weight: 500;
		text-decoration: none;

		box-shadow: var(--shadow-sm);

		transition:
			background var(--theme-transition),
			color var(--theme-transition),
			border-color var(--theme-transition),
			transform var(--theme-transition),
			box-shadow var(--theme-transition);
	}

	.cv-button a:hover {
		background: var(--accent-regular);
		color: var(--accent-text-over);
		border-color: var(--accent-regular);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header .section-label {
		color: var(--accent-dark);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	/* ====================================================== */
	/* About preview */

	.about-preview {
		position: relative;
		padding: 4rem 0;
		}

	.about-preview::before {
		/* keep your existing ::before styles */
	}

	.about-preview-content {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		width: 100%;
		max-width: 65rem;
		margin-inline: auto;
	}

	.about-preview .section-header {
		justify-self: unset;
		text-align: left;
		max-width: none;
	}

	.about-preview .section-header h3 {
		margin: 0;
	}

	.about-preview-text {
		width: 100%;
		max-width: none;
		color: var(--gray-300);
		font-size: var(--text-md);
		line-height: 1.7;
	}

	.about-preview-text p + p {
		margin-top: 1rem;
	}

	.about-preview-carousel {
		width: 100%;
		max-width: 55rem;
		margin: 1rem auto 0;
	}

	.about-cta {
		display: flex;
		justify-content: center;
		margin-top: 1rem;
	}

	@media (min-width: 50em) {
		.about-preview {
			padding: 5rem 2rem;
		}

		.about-preview-content {
			max-width: 100%;
		}

		.about-preview .section-header {
			text-align: left;
		}

		.about-preview .section-header h3 {
			font-size: var(--text-4xl);
		}

		.about-preview-text {
			max-width: 65rem;
		}

		.about-preview-carousel {
			max-width: 55rem;
		}
	}
</style>
